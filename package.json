{
  "name": "mixtape-ui",
  "productName": "MixTape",
  "version": "1.0.0",
  "description": "Einfacher Mehrspur-Editor für Mixtapes – Musik, Sprachaufnahmen, YouTube-Import, Notizen & Export.",
  "main": "electron/main.cjs",
  "author": "Holger S.",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c magenta,cyan \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/electron.cjs\"",
    "build": "vite build",
    "start": "vite build && node scripts/electron.cjs",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "de.omos.mixtape",
    "productName": "MixTape",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.0",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
